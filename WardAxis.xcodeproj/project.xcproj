  "targets": [
    {
      "name": "WardAxis",
      "id": "A5C24CE229B20A4200B8D860",
      "product": "Products/WardAxis.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Configurations", "relative-path": "app/app-debug.xcconfig" } },
        { "name": "Lab", "file": { "anchor": "Configurations", "relative-path": "app/app-lab.xcconfig" } },
        { "name": "Release", "file": { "anchor": "Configurations", "relative-path": "app/app-release.xcconfig" } },
      ],
      "dependencies": [
        { "target": "NetworkFilter", "platforms": [ "macos" ] },
        { "target": "TransparentProxy", "platforms": [ "macos" ] },
        { "target": "DNSProxy", "platforms": [ "macos" ] },
        { "target": "URLFilter", "platforms": [ "ios", "macos" ] },
        { "target": "PacketTunnel", "platforms": [ "ios", "tvos" ] },
        { "target": "SafariWebExtension", "platforms": [ "ios", "macos" ] },
        { "target": "MailExtension", "platforms": [ "macos" ] },
        { "target": "Agent", "platforms": [ "macos" ] },
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "SwiftFormat",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "# Skip formatting for CLI builds (xcodebuild)",
            "if [ -z \"$XPC_SERVICE_NAME\" ]; then",
            "    exit 0",
            "fi",
            "",
            "# Format modified Swift files only",
            "# Uses formatter.py which runs SwiftFormat + adds blank line indentation",
            "if [ -f \"$SRCROOT/scripts/formatter.py\" ]; then",
            "    cd \"$SRCROOT\"",
            "    python3 scripts/formatter.py",
            "fi",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed System Extensions",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(SYSTEM_EXTENSIONS_FOLDER_PATH)",
        }, {
          "kind": "copy",
          "name": "Embed ExtensionKit Extensions",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(EXTENSIONS_FOLDER_PATH)",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Login Items",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Library/LoginItems",
        },
      ],
      "package-product-members": [
        {
          "product-name": "WardAxisManagement",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "WardAxisTelemetry",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
