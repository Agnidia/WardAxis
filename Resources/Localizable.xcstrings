    "settings.developer.footer" : {
      "comment" : "Footer of the DEBUG-only Developer section",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debug builds only. Installs or removes the NetworkFilter system extension. No filter configuration is saved, so no traffic reaches the extension. Run the app from /Applications."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише для debug-збірок. Встановлює або видаляє системне розширення NetworkFilter. Конфігурація фільтра не зберігається, тому трафік не потрапляє до розширення. Запускайте застосунок із /Applications."
          }
        }
      }
    },
    "settings.developer.status.activated" : {
      "comment" : "DEBUG system extension status: activation completed",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
