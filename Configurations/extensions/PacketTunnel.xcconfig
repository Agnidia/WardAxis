// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

#include "extension.xcconfig"

//Packaging
PRODUCT_BUNDLE_IDENTIFIER = $(PACKET_TUNNEL_BUNDLE_ID)
INFOPLIST_FILE = Extensions/PacketTunnel/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = WardAxis Packet Tunnel
SUPPORTED_PLATFORMS = iphoneos iphonesimulator appletvos appletvsimulator
TARGETED_DEVICE_FAMILY = 1,2,3

//Signing
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = Configurations/Entitlements/PacketTunnel.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] = Configurations/Entitlements/PacketTunnel.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=appletvos*] = Configurations/Entitlements/PacketTunnel.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=appletvsimulator*] = Configurations/Entitlements/PacketTunnel.entitlements
