#include "extension.xcconfig"

//Packaging
PRODUCT_BUNDLE_IDENTIFIER = $(MAIL_EXTENSION_BUNDLE_ID)
INFOPLIST_FILE = Extensions/MailExtension/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = WardAxis for Mail
SUPPORTED_PLATFORMS = macosx

//Signing
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Configurations/Entitlements/MailExtension.entitlements
