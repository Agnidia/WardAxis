//
//  base.xcconfig
//  WardAxis
//
//  Created by vitalii on 05.03.2023.
//

// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

#include "sign.xcconfig"

//User-Defined
APP_NAME = WardAxis
APP_DOMAIN = com.agnidia
// Lowercase reverse-DNS root shared by the app, its extensions and the OSLog subsystem.
APP_BUNDLE_ID = $(APP_DOMAIN).wardaxis
MTL_FAST_MATH = YES

//Architectures
SUPPORTED_PLATFORMS = macosx iphoneos iphonesimulator appletvos appletvsimulator
SDKROOT = auto
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0
TVOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2,3

//Build Options
ALLOW_TARGET_PLATFORM_SPECIALIZATION = YES
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO

//Deployment
COPY_PHASE_STRIP = NO

//Info.plist Values
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities

//Linking
DEAD_CODE_STRIPPING = YES
LD_RUNPATH_SEARCH_PATHS = @executable_path/Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = @executable_path/../Frameworks

//Localization
STRING_CATALOG_GENERATE_SYMBOLS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

//Packaging
PRODUCT_NAME = $(TARGET_NAME)
GENERATE_INFOPLIST_FILE = YES
DEFINES_MODULE = YES

//Search Paths
ALWAYS_SEARCH_USER_PATHS = NO

//Versioning
CURRENT_PROJECT_VERSION = 1000
MARKETING_VERSION = 1.0.0

//Apple Clang - Code Generation
GCC_NO_COMMON_BLOCKS = YES

//Swift Compiler - Language
// Language mode, not the compiler version: Xcode 27.2 builds with the Swift 6.4 toolchain.
SWIFT_VERSION = 6
SWIFT_STRICT_CONCURRENCY = complete

//Apple Clang - Language
GCC_C_LANGUAGE_STANDARD = gnu23

//Apple Clang - Language - C++
CLANG_CXX_LANGUAGE_STANDARD = gnu++23

//Apple Clang - Language - Modules
CLANG_ENABLE_MODULES = YES

//Apple Clang - Language - Objective-C
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_OBJC_WEAK = YES

//Apple Clang - Preprocessing
ENABLE_STRICT_OBJC_MSGSEND = YES

//Apple Clang - Warnings - All languages
CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_BOOL_CONVERSION = YES
CLANG_WARN_CONSTANT_CONVERSION = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
CLANG_WARN_ENUM_CONVERSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_NON_LITERAL_NULL_CONVERSION = YES
CLANG_WARN_INFINITE_RECURSION = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES
CLANG_WARN_STRICT_PROTOTYPES = YES
CLANG_WARN_COMMA = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE
CLANG_WARN_UNREACHABLE_CODE = YES
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES

//Apple Clang - Warnings - C++
CLANG_WARN_RANGE_LOOP_ANALYSIS = YES
CLANG_WARN_SUSPICIOUS_MOVE = YES

//Apple Clang - Warnings - Objective-C
CLANG_WARN_DIRECT_OBJC_ISA_USAGE = YES_ERROR
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES
CLANG_WARN_OBJC_LITERAL_CONVERSION = YES
CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = YES
GCC_WARN_UNDECLARED_SELECTOR = YES
CLANG_WARN_OBJC_ROOT_CLASS = YES_ERROR

//Apple Clang - Warnings - Objective-C and ARC
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = YES

//Apple Clang Module Verifier - Options
ENABLE_MODULE_VERIFIER = YES
MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS = gnu23 gnu++23
MODULE_VERIFIER_SUPPORTED_LANGUAGES = objective-c objective-c++

//Settings
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

//Static Analysis - Generic Issues
CLANG_ANALYZER_NONNULL = YES

//Static Analysis - Issues - Apple APIs
CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION = YES_AGGRESSIVE
CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED = YES
