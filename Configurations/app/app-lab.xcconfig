#include "../lab.xcconfig"
#include "app.xcconfig"

//API
// Same as Release: https only. `/$()/` stops xcconfig from reading `//` as a comment.
// Host only: the app appends the contract's servers path (/v1); a path here is rejected.
API_BASE_URL = https:/$()/api.invalid
