#include "../release.xcconfig"
#include "app.xcconfig"

//API
// Placeholder that never resolves (RFC 6761) until a deploy sets the real host.
// Release builds accept https only. `/$()/` stops xcconfig from reading `//` as a comment.
// Host only: the app appends the contract's servers path (/v1); a path here is rejected.
API_BASE_URL = https:/$()/api.invalid
