{
  "schema": "wardaxis.security-policy",
  "schemaVersion": 1,
  "body": {
    "identifier": "office-network",
    "revision": 7,
    "defaultAction": "deny",
    "rules": [
      {
        "identifier": "browser-web",
        "action": "allow",
        "application": {"signingIdentifier": "com.example.browser", "teamIdentifier": "EXAMPLE001", "isPlatformBinary": false},
        "destinationHosts": ["example.com", "*.example.org"]
      },
      {
        "identifier": "system-curl",
        "action": "allow",
        "application": {"signingIdentifier": "com.apple.curl", "isPlatformBinary": true}
      },
      {
        "identifier": "block-tracker",
        "action": "deny",
        "destinationHosts": ["tracker.example.net"]
      }
    ]
  }
}
