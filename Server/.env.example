# Overrides for Server/compose.yaml. Copy to Server/.env (git-ignored) and edit.
# Every value here is a local-only development default; compose uses the same
# defaults when Server/.env is absent. Never put a production credential here.

# PostgreSQL container
POSTGRES_USER=wardaxis
# Must be URL-safe (letters, digits, - . _ ~): compose inserts it unencoded into
# the server's DATABASE_URL, so a reserved character breaks the URL.
POSTGRES_PASSWORD=local-dev-not-a-secret
POSTGRES_DB=wardaxis
# Host port for PostgreSQL, bound to 127.0.0.1
POSTGRES_PORT=5432

# Server container
# Required by the server. Compose builds DATABASE_URL from the POSTGRES_* values;
# outside compose, set DATABASE_URL yourself, for example
#   DATABASE_URL=postgres://wardaxis:local-dev-not-a-secret@127.0.0.1:5432/wardaxis?sslmode=disable
# Percent-encode reserved characters (@ : / ? # %) in a password inside the URL.
# sslmode is require (the default when absent), prefer or disable. require verifies
# the certificate chain and host name, stricter than libpq's require. disable is
# for a local database only; compose and CI set it because their Postgres has no TLS.
# development or production (the server's default when unset). development allows
# plain HTTP on 127.0.0.1.
SERVER_ENVIRONMENT=development
# trace, debug, info (default), notice, warning, error or critical
LOG_LEVEL=info
# true or false: serve the API reference at /v1/docs and the contract at
# /v1/openapi.yaml. Unset or empty means on in development and off in production.
# Production never serves them: start-up refuses true with SERVER_ENVIRONMENT=production
# or unset.
# API_DOCS_ENABLED=true
# Host port for the server, bound to 127.0.0.1
SERVER_PORT=8080
# Compose project name (default wardaxis); a second name runs a second stack.
# COMPOSE_PROJECT_NAME=wardaxis

# Read by the server itself, not by compose (compose fixes them inside the container):
#   HOST (default 0.0.0.0), PORT (default 8080), DATABASE_URL (required)
# HOST must be an address that loopback reaches (0.0.0.0 or 127.0.0.1): the image
# healthcheck probes /v1/health on 127.0.0.1.

# TLS for the server's own listener, also read by the server, not by compose. Set both
# or neither. SERVER_ENVIRONMENT=production refuses to start without them; development
# serves plain HTTP when both are unset, as compose does on 127.0.0.1. Each is a path
# to a PEM file the server can read: the certificate chain (leaf first), and the
# unencrypted private key (mode 0600). Keep both files out of the repository and image.
# TLS_CERTIFICATE_CHAIN_PATH=
# TLS_PRIVATE_KEY_PATH=
# The device CA bundle (PEM, one or more CA certificates). With it, every TLS handshake
# must present a client certificate that chains to this CA, and the config feed at
# /v1/config/stream is served; without it the feed does not exist. Needs both paths
# above: start-up refuses it alone.
# TLS_CLIENT_CA_PATH=
# With TLS_CLIENT_CA_PATH, the container healthcheck (not the server) presents this
# device-CA client identity to reach /v1/health; without it the probe fails closed.
# HEALTHCHECK_CLIENT_CERTIFICATE_PATH=
# HEALTHCHECK_CLIENT_KEY_PATH=
